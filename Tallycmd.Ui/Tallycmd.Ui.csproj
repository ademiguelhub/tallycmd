<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    </PropertyGroup>

    <Target Name="TailwindBuild" BeforeTargets="Build">
        <Exec Command="npx @tailwindcss/cli -i ./wwwroot/css/app.css -o ./wwwroot/css/app.min.css --content &quot;./**/*.{razor,html,cs}&quot;" />
    </Target>

    <ItemGroup>
        <ProjectReference Include="..\Tallycmd.Common\Tallycmd.Common.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="10.0.2" />
    </ItemGroup>

</Project>